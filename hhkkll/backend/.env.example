# Copy to .env on the server (never commit the real file, never put it in the app).
ANTHROPIC_API_KEY=
# Model used for generation and verification (default: claude-opus-5-5).
HHKKLL_MODEL=claude-opus-5-5
# Hard spending cap per UTC day, in USD.
DAILY_BUDGET_USD=3
PORT=8080
DATA_DIR=data
BATCH_SIZE=6
LOW_WATERMARK=6
RATE_PER_MINUTE=60
