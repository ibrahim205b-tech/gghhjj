# ENJAZ — environment variable NAMES only. Never commit real values.

# --- Public client configuration (safe to ship in the app / web bundle; protected by RLS) ---
# Student app:  flutter build apk --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
# Admin web:    apps/admin/.env  (VITE_ prefix)
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_SENDER_ID=
FIREBASE_PROJECT_ID=

# --- Server secrets (Supabase -> Edge Functions -> Secrets ONLY; never in apps or git) ---
FCM_SERVICE_ACCOUNT=
CRON_SECRET=

# --- Supabase Auth Google provider (Supabase dashboard / local CLI env only) ---
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# --- GitHub repository secrets for release signing (never in files) ---
# ENJAZ_KEYSTORE_BASE64, ENJAZ_KEYSTORE_PASSWORD, ENJAZ_KEY_ALIAS, ENJAZ_KEY_PASSWORD
