# Sawti AI backend — environment variables (names only, NO real values here).
# On Hugging Face, set SAWTI_API_KEY as a Space *secret*, never as a variable.

# Required. Long random string shared with the app (typed once in the app's settings).
SAWTI_API_KEY=

# Engine: silma (default) | chatterbox
SAWTI_ENGINE=silma

# Where voices / temporary audio are kept. /tmp is wiped on restart.
SAWTI_DATA_DIR=/tmp/sawti

# Limits
SAWTI_MAX_UPLOAD_MB=25
SAWTI_MAX_SAMPLE_SECONDS=120
SAWTI_MAX_TEXT_CHARS=2000
SAWTI_AUDIO_TTL_MINUTES=60
SAWTI_UPLOAD_TTL_MINUTES=30
SAWTI_JOB_TIMEOUT_SECONDS=1800
SAWTI_MAX_QUEUE=4
SAWTI_RATE_LIMIT_PER_MINUTE=60

# Load the model at startup (1) or on first request (0)
SAWTI_PRELOAD=1
SAWTI_THREADS=
SAWTI_LOG_LEVEL=INFO

# --- GitHub repository secrets used by the workflows (set in GitHub, not here) ---
# HF_TOKEN=                       Hugging Face write token (deploy workflow)
# SAWTI_API_KEY=                  same value as above (deploy workflow)
# ANDROID_KEYSTORE_BASE64=        optional release signing
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
